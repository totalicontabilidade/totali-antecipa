rules_version = '2';
// Totali Antecipa — regras do Firestore
// Cole em: Console Firebase › Firestore Database › Regras › Publicar
service cloud.firestore {
  match /databases/{db}/documents {
    function logado() { return request.auth != null; }
    function meuPerfil() { return get(/databases/$(db)/documents/usuarios/$(request.auth.uid)).data; }
    function temPerfil() { return exists(/databases/$(db)/documents/usuarios/$(request.auth.uid)); }
    function aprovado() { return logado() && temPerfil() && meuPerfil().aprovado == true; }
    function admin() { return logado() && temPerfil() && meuPerfil().admin == true; }
    // E-mails do escritório (@totalicontabilidade.com.br) viram administradores sozinhos,
    // desde que o e-mail tenha sido verificado (link enviado pelo Firebase)
    function ehEmailTotali() {
      return logado()
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@totalicontabilidade[.]com[.]br')
        && request.auth.token.email_verified == true;
    }

    match /usuarios/{uid} {
      allow get: if logado() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if logado() && request.auth.uid == uid
        && ((request.resource.data.aprovado == false && request.resource.data.admin == false) || ehEmailTotali());
      // o próprio usuário só mexe em campos inofensivos (avisoEm, nome); aprovado/admin só o administrador
      // ou o próprio, quando for e-mail verificado da Totali (promoção automática)
      allow update: if admin()
        || (logado() && request.auth.uid == uid && ehEmailTotali())
        || (logado() && request.auth.uid == uid
            && request.resource.data.aprovado == resource.data.aprovado
            && request.resource.data.admin == resource.data.admin);
      allow delete: if admin();

      // certificados A1 guardados no login: só o próprio dono (nem administradores)
      match /certificados/{cnpj} {
        allow read, write: if logado() && request.auth.uid == uid;
      }
    }

    // e-mails: registro dos avisos (e fila da extensão "Trigger Email", se instalada)
    match /mail/{id} {
      allow create: if logado();
      allow read, update, delete: if false;
    }

    // dados do escritório: só usuários autorizados
    match /escritorio/{doc=**} {
      allow read, write: if aprovado();
    }
  }
}
